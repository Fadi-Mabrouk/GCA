<Window x:Class="GCA.UI.Views.PartEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part Editor" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Part Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="SKU"/>
            <TextBox Text="{Binding SKU}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Category"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Price"/>
                    <TextBox Text="{Binding UnitPrice}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Quantity"/>
                    <TextBox Text="{Binding Quantity}" Margin="0,0,0,10" Padding="5"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="State"/>
            <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" Margin="0,0,0,20" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="Save" Click="Save_Click" IsDefault="True" Padding="15,5" Background="{StaticResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
