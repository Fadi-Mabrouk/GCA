<UserControl x:Class="GCA.UI.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GCA.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SaleViewModel}"
             Padding="20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: PART CATALOG -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="Available Parts" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="250" Padding="5">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Search" Command="{Binding SearchCommand}" Margin="10,0,0,0" Padding="15,5"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding AvailableParts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="1" BorderBrush="Gray">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTemplateColumn Header="Action" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Add" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Background="#2ECC71" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- RIGHT: SHOPPING CART -->
        <Border Grid.Column="1" Background="#ECF0F1" CornerRadius="5" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Current Sale" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Client Selector -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                    <TextBlock Text="Select Client:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Name" SelectedIndex="0" Padding="5"/>
                </StackPanel>

                <!-- Cart Items -->
                <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Cart}" Height="300" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part" Binding="{Binding PartName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=C}" Width="80"/>
                        <DataGridTemplateColumn Header="Remove" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Background="Red" Foreground="White"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Total & Checkout -->
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Separator Margin="0,10"/>
                    <DockPanel>
                        <TextBlock Text="TOTAL:" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat=C}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    
                    <Button Content="✅ Complete Sale" Command="{Binding CheckoutCommand}" 
                            FontSize="18" FontWeight="Bold" Background="#27AE60" Foreground="White" Padding="10" Margin="0,20,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
