<Window x:Class="GCA.UI.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="New User Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Username"/>
            <TextBox Text="{Binding Username}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Password"/>
            <PasswordBox Name="PasswordBox" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Full Name"/>
            <TextBox Text="{Binding FullName}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Role"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="0,0,0,20" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="Create" Click="Save_Click" IsDefault="True" Padding="15,5" Background="{StaticResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
