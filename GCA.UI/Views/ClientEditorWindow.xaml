<Window x:Class="GCA.UI.Views.ClientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Editor" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Client Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Phone"/>
            <TextBox Text="{Binding Phone}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email}" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Address"/>
            <TextBox Text="{Binding Address}" Margin="0,0,0,20" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="15,5" Margin="0,0,10,0"/>
                <Button Content="Save" Click="Save_Click" IsDefault="True" Padding="15,5" Background="{StaticResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
