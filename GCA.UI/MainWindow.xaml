<Window x:Class="GCA.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:GCA.UI.ViewModels"
        xmlns:views="clr-namespace:GCA.UI.Views"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:StockViewModel}">
            <views:StockView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ClientViewModel}">
            <views:ClientView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SupplierViewModel}">
            <views:SupplierView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SaleViewModel}">
            <views:SaleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PurchaseViewModel}">
            <views:PurchaseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SalesHistoryViewModel}">
            <views:SalesHistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PurchaseHistoryViewModel}">
            <views:PurchaseHistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UserViewModel}">
            <views:UserView/>
        </DataTemplate>
        
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    
    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#2C3E50" Width="250" Padding="20"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="GCA" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,40" HorizontalAlignment="Center"/>
                
                <Button Content="📊 Dashboard" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="📦 Stock" Command="{Binding NavigateToStockCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="👥 Clients" Command="{Binding NavigateToClientsCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="🚛 Suppliers" Command="{Binding NavigateToSuppliersCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="📈 Sales" Command="{Binding NavigateToSalesCommand}" Style="{StaticResource SidebarButton}" />
                <Button Content="📥 Purchases" Command="{Binding NavigateToPurchasesCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="📊 Sales History" Command="{Binding NavigateToReportsCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="📜 Purchase Hist" Command="{Binding NavigateToPurchaseHistoryCommand}" Style="{StaticResource SidebarButton}"/>
                
                <Separator Background="#7F8C8D" Margin="0,20,0,20"/>
                
                <Button Content="⚙ Users" Command="{Binding NavigateToUsersCommand}" Style="{StaticResource SidebarButton}"/>
                <Button Content="🚪 Logout" Command="{Binding LogoutCommand}" Style="{StaticResource SidebarButton}" Background="#C0392B"/>
            </StackPanel>
        </Border>
        
        <!-- CONTENT AREA -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="20"/>
        </Grid>
    </Grid>
</Window>
